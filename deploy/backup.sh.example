#!/usr/bin/env bash
#
# Example MySQL + media backup for app-booking.
# Copy outside the repository, fill environment variables and schedule it.
#
# Required:
#   DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# Optional:
#   APP_DIR (default /var/www/app-booking/current)
#   BACKUP_DIR (default /var/backups/app-booking)
#   RETENTION_DAYS (default 7)
#
# The example keeps backups on the same host. Copy them offsite or use the
# provider's managed backup for disaster recovery.

set -euo pipefail
umask 077

: "${DB_HOST:?DB_HOST is required}"
: "${DB_DATABASE:?DB_DATABASE is required}"
: "${DB_USERNAME:?DB_USERNAME is required}"
: "${DB_PASSWORD:?DB_PASSWORD is required}"

DB_PORT="${DB_PORT:-3306}"
APP_DIR="${APP_DIR:-/var/www/app-booking/current}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/app-booking}"
RETENTION_DAYS="${RETENTION_DAYS:-7}"
STAMP="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$BACKUP_DIR"

MYSQL_PWD="$DB_PASSWORD" mysqldump \
    --host="$DB_HOST" \
    --port="$DB_PORT" \
    --user="$DB_USERNAME" \
    --single-transaction \
    --routines \
    --triggers \
    --no-tablespaces \
    "$DB_DATABASE" | gzip > "$BACKUP_DIR/db-$STAMP.sql.gz"

tar -czf "$BACKUP_DIR/storage-$STAMP.tar.gz" \
    -C "$APP_DIR" \
    storage/app/public

find "$BACKUP_DIR" -type f -mtime "+$RETENTION_DAYS" -delete

echo "Backup completed: $BACKUP_DIR/db-$STAMP.sql.gz"
